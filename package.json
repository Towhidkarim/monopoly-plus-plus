{
  "name": "skyline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @skyline/web dev",
    "build": "pnpm --filter @skyline/web build",
    "deploy": "pnpm --filter @skyline/web deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test",
    "sim": "pnpm --filter @skyline/bots sim",
    "assets:audio": "node tools/assets/pack-audio.ts",
    "shot": "node tools/dev/shot.ts",
    "shot:headless": "node tools/dev/headless.ts",
    "room:smoke": "node tools/dev/room-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
